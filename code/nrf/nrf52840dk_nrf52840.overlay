// You can also use the buttons in the sidebar to perform actions on nodes.
// Actions currently available include:

// * Enabling / disabling the node
// * Adding the bus to a bus
// * Removing the node
// * Connecting ADC channels

// For more help, browse the DeviceTree documentation at https://docs.zephyrproject.org/latest/guides/dts/index.html
// You can also visit the nRF DeviceTree extension documentation at https://docs.nordicsemi.com/bundle/nrf-connect-vscode/page/guides/ncs_configure_app.html#devicetree-support-in-the-extension
&uart0 {
    current-speed = <115200>;
    data-bits = <8>;
    hw-flow-control;
    stop-bits = "1";
    parity = "none";
};


&uart1 {
    status = "okay";
        data-bits = <8>;
    current-speed = <9600>;
    stop-bits = "1";
    parity = "none";
};

&i2c0{
    highgaccelsensor:highgaccelsensor@19{
        compatible = "i2c-device"; // telling nordic to use raw i2c driver
        status="okay";
        reg = <0x19>;              // address of the accelerameter
        label = "HIGHGACCELSENSOR";   // label
    };    
    accelsensor:accelsensor@6B{
        compatible = "i2c-device"; // telling nordic to use raw i2c driver
        status = "okay";
        reg = <0x6B>;              // address of the accelerameter
        label = "ACCELSENSOR";   // label
    };
    magnetometer:magnetometer@30{
        compatible="i2c-device";
        status="okay";
        reg = <0x30>;
        label="MAGNETOMETER";
    };

};